10. Booking Seat Testing
Future<void> bookingTest(String tripId) async {
  DocumentReference tripRef =
      FirebaseFirestore.instance.collection('trips').doc(tripId);

  FirebaseFirestore.instance.runTransaction((transaction) async {
    DocumentSnapshot snapshot = await transaction.get(tripRef);

    int seats = snapshot['seats'];

    if (seats > 0) {
      transaction.update(tripRef, {
        'seats': seats - 1,
      });

      print("Booking Test Passed");
    } else {
      print("No Seats Available");
    }
  });
}
Expected Result
Seat count should decrease after booking.
